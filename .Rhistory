# Uruchomienie pełnego, rygorystycznego testu pakietu
devtools::check()
# Pozostawiamy bezpieczną dla CRAN flagę maksymalnej optymalizacji pętli -O3
makevars_safe <- 'PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS) -O3
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)'
# Nadpisujemy pliki konfiguracyjne
writeLines(makevars_safe, "src/Makevars")
writeLines(makevars_safe, "src/Makevars.win")
library(devtools)
devtools::document()
devtools::check()
cat("# NormGen 0.0.2
* Performance release with compiler optimization flags (-O3).
* Replaced NumericVector element access with faster direct C++ double pointers in Rnorm_cpp loop to dramatically increase execution speed.
", file = "NEWS.md")
cat("## Test environment
* local Windows install, R 4.3.1
* win-builder (devel)
## R CMD check results
0 errors | 0 warnings | 2 notes
* This is an update to an existing release.
* NOTE regarding compilation flags: The -O3 flag is intentionally added to allow the C++ compiler to optimize heavy loops in the quantile mapping algorithm, which is critical for the package's performance.
", file = "cran-comments.md")
devtools::submit_cran()
library(devtools)
# Finałowe wysłanie zoptymalizowanej wersji 0.0.2 na serwery CRAN
devtools::submit_cran()
# Usuwamy stare spakowane wersje, aby zmusić system do zbudowania nowej
old_tars <- list.files("..", pattern = "NormGen_.*\\.tar\\.gz", full.names = TRUE)
file.remove(old_tars)
library(devtools)
# Nadpisujemy plik DESCRIPTION z jednoznacznym numerem 0.0.2
desc_content <- 'Package: NormGen
Title: Pseudo-normal random generator
Version: 0.0.2
Authors@R: person("Piotr", "Sulewski", , "piotr.sulewski@upsl.edu.pl", role = c("aut", "cre"))
Description: High-performance pseudo-normal random generator using an optimized quantile mapping algorithm. Version 0.0.2 includes compiler optimizations for maximum execution speed.
Depends: R (>= 3.5.0)
Imports: Rcpp (>= 1.0.0)
LinkingTo: Rcpp
Suggests:
testthat (>= 3.0.0),
knitr,
rmarkdown
VignetteBuilder: knitr
License: GPL-3
Language: en-US
Encoding: UTF-8
Roxygen: list(markdown = TRUE)
RoxygenNote: 7.2.3
LazyData: true'
writeLines(desc_content, "DESCRIPTION", useBytes = TRUE)
# Odświeżamy dokumentację, aby Roxygen zaktualizował pliki indeksowe na wersję 0.0.2
devtools::document()
library(devtools)
devtools::submit_cran()
library(devtools)
# 1. Czyszczenie środowiska
devtools::clean_dll()
# 2. Budujemy pakiet w wersji 0.0.2 bezpośrednio na dysku C
pkg_path <- devtools::build(binary = FALSE, manual = FALSE, args = "--resave-data")
message("Twój poprawny plik znajduje się w: ", pkg_path)
# Definiujemy ścieżkę do wygenerowanego pliku tymczasowego
sciezka_temp <- "C:/Users/piotr/AppData/Local/Temp/RtmpQ5gOtd/file42a02677aa/NormGen_0.0.2.tar.gz"
# Kopiujemy go bezpośrednio na Twój Pulpit w Windowsie
file.copy(from = sciezka_temp, to = "~/../Desktop/NormGen_0.0.2.tar.gz", overwrite = TRUE)
library(devtools)
# Budujemy pakiet bezpośrednio w Twoim katalogu użytkownika (tam nie ma blokad uprawnień)
pkg_path <- devtools::build(binary = FALSE, manual = FALSE, path = "~")
message("Twój poprawny plik znajduje się w: ", pkg_path)
install.packages('NormGen')
install.packages("NormGen")
