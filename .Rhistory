cat("#' @title Normal generator
#' @description Random generation for the normal distribution.
#' @param n number of observations.
#' @param m vector of means.
#' @param s vector of standard deviations.
#' @return Random generation for the normal distribution.
#' @useDynLib NormGen, .registration = TRUE
#' @importFrom Rcpp sourceCpp
#' @export
Rnorm <- function(n, m = 0, s = 1) {
return(Rnorm_cpp(n, m, s))
}
", file = "R/Rnorm.R")
